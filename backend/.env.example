# ============================================================
# SmartDispatch — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# These are only needed for PRODUCTION mode (spring.profiles.active=prod).
# For local development, the app uses H2 in-memory DB + local file storage.

# ============================================================
# SUPABASE PostgreSQL
# ============================================================
# Go to: https://supabase.com → Your Project → Settings → Database
# Copy the "Connection string" (JDBC format)
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR-PROJECT-ID.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ============================================================
# CLOUDFLARE R2 (S3-compatible Object Storage)
# ============================================================
# Go to: https://dash.cloudflare.com → R2 Object Storage
# 1. Create a bucket named "smartdispatch-assets"
# 2. Go to Settings → R2 API tokens → Create token
# 3. Copy the Account ID, Access Key, and Secret Key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=smartdispatch-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ============================================================
# STORAGE MODE
# ============================================================
# "local" = save files to ./uploads/ folder (dev)
# "r2"    = save files to Cloudflare R2 bucket (prod)
STORAGE_MODE=r2
